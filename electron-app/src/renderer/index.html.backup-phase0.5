<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:*; img-src 'self' data:; font-src 'self' data:;">
  <title>Polly</title>
  <link rel="stylesheet" href="styles/main.css">
  <script src="lucide.min.js"></script>
</head>
<body>
  <div id="app">
    <!-- Titlebar -->
    <div class="titlebar">
      <div class="titlebar-drag"></div>
      <div class="titlebar-title">Polly</div>
      <div class="titlebar-status">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-text">Connecting...</span>
      </div>
    </div>

    <!-- Main Content -->
    <div class="main-container">
      <!-- Sidebar -->
      <nav class="sidebar">
        <div class="sidebar-header">
          <i data-lucide="bird" class="logo-icon"></i>
          <span class="logo-text">polly</span>
        </div>

        <div class="nav-section">
          <button class="nav-item active" data-view="chat">
            <i data-lucide="message-square" class="nav-icon"></i>
            <span class="nav-label">chat</span>
          </button>
          <button class="nav-item" data-view="dashboard">
            <i data-lucide="layout-dashboard" class="nav-icon"></i>
            <span class="nav-label">dashboard</span>
          </button>
          <button class="nav-item" data-view="knowledge">
            <i data-lucide="brain" class="nav-icon"></i>
            <span class="nav-label">knowledge</span>
          </button>
          <button class="nav-item" data-view="patterns">
            <i data-lucide="sparkles" class="nav-icon"></i>
            <span class="nav-label">patterns</span>
          </button>
        </div>

        <div class="nav-section nav-bottom">
          <button class="nav-item" data-view="settings">
            <i data-lucide="settings" class="nav-icon"></i>
            <span class="nav-label">settings</span>
          </button>
        </div>
      </nav>

      <!-- Content Area -->
      <main class="content">
        <!-- Setup View (shown first if not configured) -->
        <div class="view" id="view-setup">
          <div class="setup-container">
            <div class="setup-header">
              <i data-lucide="bird" class="setup-logo"></i>
              <h1>welcome to polly</h1>
              <p>your edge-native personal AI assistant</p>
              <div class="ascii-art" style="margin-top: 1rem;">
:>  polly  -&
    setup wizard
              </div>
            </div>

            <div class="setup-steps">
              <!-- Step 1: Dependencies -->
              <div class="setup-step active" id="step-1">
                <h2>step 1: check dependencies</h2>
                <p>let's make sure you have everything needed.</p>

                <div class="dependency-list" id="dependency-list">
                  <div class="dependency-item" id="dep-python">
                    <span class="dep-icon">⏳</span>
                    <span class="dep-name">Python 3.10+</span>
                    <span class="dep-status">Checking...</span>
                  </div>
                  <div class="dependency-item" id="dep-ollama">
                    <span class="dep-icon">⏳</span>
                    <span class="dep-name">Ollama</span>
                    <span class="dep-status">Checking...</span>
                  </div>
                </div>

                <div class="setup-actions">
                  <button class="btn btn-primary" id="btn-check-deps">Check Dependencies</button>
                </div>
              </div>

              <!-- Step 2: Paths -->
              <div class="setup-step" id="step-2">
                <h2>step 2: configure paths</h2>
                <p>tell polly where to find your knowledge.</p>

                <div class="form-group">
                  <label>obsidian vault</label>
                  <div class="path-input">
                    <input type="text" id="vault-path" placeholder="select your obsidian vault..." readonly>
                    <button class="btn btn-secondary" id="btn-select-vault">browse</button>
                  </div>
                </div>

                <div class="form-group">
                  <label>code directories</label>
                  <div class="path-list" id="code-paths">
                    <div class="path-empty">no directories selected</div>
                  </div>
                  <button class="btn btn-secondary" id="btn-add-code">+ add directory</button>
                </div>

                <div class="setup-actions">
                  <button class="btn btn-secondary" id="btn-back-1">back</button>
                  <button class="btn btn-primary" id="btn-next-2">continue</button>
                </div>
              </div>

              <!-- Step 3: Install -->
              <div class="setup-step" id="step-3">
                <h2>step 3: install & configure</h2>
                <p>setting up polly's environment...</p>

                <div class="install-options">
                  <label class="checkbox-label">
                    <input type="checkbox" id="opt-pull-models" checked>
                    <span>download AI models (recommended, ~4GB)</span>
                  </label>
                </div>

                <div class="progress-container" id="install-progress" style="display: none;">
                  <div class="progress-bar">
                    <div class="progress-fill" id="progress-fill"></div>
                  </div>
                  <div class="progress-text" id="progress-text">preparing...</div>
                </div>

                <div class="setup-actions">
                  <button class="btn btn-secondary" id="btn-back-2">back</button>
                  <button class="btn btn-primary" id="btn-install">install polly</button>
                </div>
              </div>

              <!-- Step 4: Complete -->
              <div class="setup-step" id="step-4">
                <h2><i data-lucide="check-circle" style="width: 24px; height: 24px; display: inline-block; vertical-align: middle; margin-right: 8px;"></i> setup complete!</h2>
                <p>polly is ready to help you.</p>

                <div class="setup-summary">
                  <div class="summary-item">
                    <i data-lucide="check" class="summary-icon"></i>
                    <span>Python environment configured</span>
                  </div>
                  <div class="summary-item">
                    <i data-lucide="check" class="summary-icon"></i>
                    <span>AI models downloaded</span>
                  </div>
                  <div class="summary-item">
                    <i data-lucide="check" class="summary-icon"></i>
                    <span>Knowledge paths configured</span>
                  </div>
                </div>

                <div class="setup-actions">
                  <button class="btn btn-primary" id="btn-start-indexing">Index Knowledge Base</button>
                  <button class="btn btn-secondary" id="btn-skip-index">Skip for Now</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Chat View -->
        <div class="view hidden" id="view-chat">
          <div class="chat-layout">
            <!-- Conversations Sidebar -->
            <aside class="conversations-sidebar" id="conversations-sidebar">
              <div class="conversations-header">
                <button class="btn btn-primary btn-block" id="btn-new-chat">
                  <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
                  <span>New Chat</span>
                </button>
                <button class="btn-icon" id="btn-toggle-sidebar" title="Toggle sidebar">
                  <i data-lucide="panel-left-close" style="width: 18px; height: 18px;"></i>
                </button>
              </div>
              
              <div class="conversations-search">
                <input type="text" id="conversations-search-input" placeholder="Search conversations..." />
                <i data-lucide="search" class="search-icon"></i>
              </div>
              
              <div class="conversations-list" id="conversations-list">
                <!-- Conversations will be rendered here -->
              </div>
            </aside>

            <!-- Main Chat Area -->
            <div class="chat-main">
              <div class="chat-container">
                <div class="chat-header">
                  <h2>> chat with polly</h2>
                  <div class="header-actions">
                <button class="btn btn-secondary btn-sm" id="btn-toggle-related" title="Toggle related notes">
                  <i data-lucide="network" style="width: 14px; height: 14px;"></i>
                  <span>Related Notes</span>
                </button>
                <button class="btn btn-secondary btn-sm" id="btn-save-conversation" title="Save conversation to Obsidian">
                  <i data-lucide="book-plus" style="width: 14px; height: 14px;"></i>
                  <span>Save to Obsidian</span>
                </button>
                <div class="mode-selector">
                  <button class="mode-btn active" data-mode="auto">auto</button>
                  <button class="mode-btn" data-mode="local">local</button>
                  <button class="mode-btn" data-mode="cloud">cloud</button>
                </div>
                  </div>
                </div>

                <div class="chat-content-wrapper">
                  <div class="chat-messages" id="chat-messages">
                    <div class="message system">
                      <div class="message-content">
                        Hi! I'm Polly, your personal AI assistant. I have access to your Obsidian vault,
                        codebases, and learned patterns. Ask me anything!
                      </div>
                    </div>
                  </div>

                  <!-- Related Notes Sidebar -->
                  <div class="related-notes-panel hidden" id="related-notes-panel">
                    <div class="related-notes-header">
                      <h3>Related Notes</h3>
                      <button class="btn-icon" id="btn-close-related" title="Close">
                        <i data-lucide="x" style="width: 16px; height: 16px;"></i>
                      </button>
                    </div>
                    
                    <div class="related-notes-status" id="related-notes-status">
                      <div style="text-align: center; padding: 20px; color: var(--text-secondary); font-size: 13px;">
                        <i data-lucide="info" style="width: 20px; height: 20px; margin-bottom: 8px;"></i>
                        <p>Start chatting to see related notes from your vault</p>
                      </div>
                    </div>
                    
                    <div class="related-notes-list" id="related-notes-list"></div>
                  </div>
                </div>

                <div class="chat-input-container">
                  <div class="quick-actions">
                    <button class="quick-btn" data-query="What patterns do I use in my code?">Patterns</button>
                    <button class="quick-btn" data-query="Summarize my recent notes">Recent Notes</button>
                    <button class="quick-btn" data-query="Show cross-domain connections">Connections</button>
                  </div>
                  <div class="chat-input">
                    <textarea id="query-input" placeholder="Ask Polly anything..." rows="1"></textarea>
                    <button class="btn btn-primary" id="btn-send">
                      <span>Send</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Context Menu for Conversations -->
        <div class="context-menu hidden" id="conversation-context-menu">
          <button class="context-menu-item" data-action="rename">
            <i data-lucide="edit" style="width: 14px; height: 14px;"></i>
            <span>Rename</span>
          </button>
          <button class="context-menu-item" data-action="star">
            <i data-lucide="star" style="width: 14px; height: 14px;"></i>
            <span>Star</span>
          </button>
          <button class="context-menu-item" data-action="category">
            <i data-lucide="folder" style="width: 14px; height: 14px;"></i>
            <span>Change Category</span>
          </button>
          <div class="context-menu-divider"></div>
          <button class="context-menu-item danger" data-action="delete">
            <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
            <span>Delete</span>
          </button>
        </div>

        <!-- Dashboard View -->
        <div class="view hidden" id="view-dashboard">
          <div class="dashboard-container">
            <h2>> dashboard</h2>

            <div class="stats-grid">
              <div class="stat-card">
                <i data-lucide="book-open" class="stat-icon"></i>
                <div class="stat-value" id="stat-obsidian">-</div>
                <div class="stat-label">Obsidian Chunks</div>
              </div>
              <div class="stat-card">
                <i data-lucide="code-2" class="stat-icon"></i>
                <div class="stat-value" id="stat-codebase">-</div>
                <div class="stat-label">Code Chunks</div>
              </div>
              <div class="stat-card">
                <i data-lucide="sparkles" class="stat-icon"></i>
                <div class="stat-value" id="stat-patterns">-</div>
                <div class="stat-label">Patterns</div>
              </div>
              <div class="stat-card">
                <i data-lucide="network" class="stat-icon"></i>
                <div class="stat-value" id="stat-entities">-</div>
                <div class="stat-label">Graph Entities</div>
              </div>
            </div>

            <div class="domains-section">
              <h3>your domains</h3>
              <div class="domains-grid">
                <div class="domain-card sigils">
                  <div class="domain-name">sigils</div>
                  <div class="domain-desc">code & infrastructure</div>
                </div>
                <div class="domain-card signals">
                  <div class="domain-name">signals</div>
                  <div class="domain-desc">audio & synthesis</div>
                </div>
                <div class="domain-card scrolls">
                  <div class="domain-name">scrolls</div>
                  <div class="domain-desc">writing & pedagogy</div>
                </div>
                <div class="domain-card glyphs">
                  <div class="domain-name">glyphs</div>
                  <div class="domain-desc">visual & design</div>
                </div>
                <div class="domain-card grids">
                  <div class="domain-name">grids</div>
                  <div class="domain-desc">systems & frameworks</div>
                </div>
              </div>
            </div>

            <div class="server-section">
              <h3>Services Status</h3>
              
              <div class="server-status">
                <div class="service-item">
                  <div class="server-indicator" id="ollama-indicator"></div>
                  <div class="service-info">
                    <div class="service-name">Ollama</div>
                    <span id="ollama-status-text">Checking...</span>
                  </div>
                </div>
                
                <div class="service-item">
                  <div class="server-indicator" id="server-indicator"></div>
                  <div class="service-info">
                    <div class="service-name">Polly Server</div>
                    <span id="server-status-text">Checking...</span>
                  </div>
                  <button class="btn btn-secondary btn-sm" id="btn-toggle-server">Start</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Knowledge View -->
        <div class="view hidden" id="view-knowledge">
          <div class="knowledge-container">
            <h2>> knowledge base</h2>

            <div class="knowledge-actions">
              <button class="btn btn-primary" id="btn-reindex">
                <i data-lucide="refresh-cw" style="width: 16px; height: 16px;"></i> Re-index All
              </button>
              <button class="btn btn-secondary" id="btn-index-obsidian">
                Index Obsidian
              </button>
              <button class="btn btn-secondary" id="btn-index-code">
                Index Code
              </button>
            </div>

            <div class="knowledge-sources">
              <div class="source-card">
                <h3><i data-lucide="book-open" style="width: 18px; height: 18px; display: inline-block; vertical-align: middle; margin-right: 8px;"></i> Obsidian Vault</h3>
                <div class="source-path" id="obsidian-path">Not configured</div>
                <div class="source-stats">
                  <span id="obsidian-files">0 files</span>
                  <span id="obsidian-chunks">0 chunks</span>
                </div>
              </div>

              <div class="source-card">
                <h3><i data-lucide="code-2" style="width: 18px; height: 18px; display: inline-block; vertical-align: middle; margin-right: 8px;"></i> Codebases</h3>
                <div class="source-paths" id="code-source-paths">
                  <div class="path-empty">No directories configured</div>
                </div>
                <div class="source-stats">
                  <span id="code-files">0 files</span>
                  <span id="code-chunks">0 chunks</span>
                </div>
              </div>
            </div>

            <div class="index-log" id="index-log" style="display: none;">
              <h3>Indexing Log</h3>
              <pre id="index-log-content"></pre>
            </div>
          </div>
        </div>

        <!-- Patterns View -->
        <div class="view hidden" id="view-patterns">
          <div class="patterns-container">
            <h2>> learned patterns</h2>
            <p class="patterns-intro">
              polly learns patterns from your work over time. these patterns help provide
              more relevant and personalized responses.
            </p>

            <!-- Pattern Controls -->
            <div class="patterns-controls">
              <div class="patterns-filters">
                <label class="filter-label">Show patterns from:</label>
                <select id="pattern-time-filter" class="pattern-filter-select">
                  <option value="all">All time</option>
                  <option value="7">Last 7 days</option>
                  <option value="30">Last 30 days</option>
                  <option value="90">Last 90 days</option>
                </select>
              </div>
              <div class="patterns-actions">
                <button class="btn btn-secondary btn-sm" id="btn-refresh-patterns">
                  <i data-lucide="refresh-cw" style="width: 14px; height: 14px;"></i>
                  Refresh
                </button>
                <button class="btn btn-secondary btn-sm" id="btn-export-patterns">
                  <i data-lucide="download" style="width: 14px; height: 14px;"></i>
                  Export
                </button>
                <button class="btn btn-danger btn-sm" id="btn-reset-patterns">
                  <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                  Reset
                </button>
              </div>
            </div>

            <div class="patterns-list" id="patterns-list">
              <div class="pattern-empty">
                <i data-lucide="sparkles" class="pattern-empty-icon"></i>
                <p>No patterns learned yet.</p>
                <p class="pattern-empty-hint">Keep using Polly and patterns will emerge from your queries and knowledge base.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Settings View -->
        <div class="view hidden" id="view-settings">
          <div class="settings-container">
            <h2>> settings</h2>

            <!-- Tab Navigation -->
            <div class="settings-tabs">
              <button class="settings-tab-btn active" data-tab="general">
                <i data-lucide="sliders" class="tab-icon"></i>
                <span class="tab-label">general</span>
              </button>
              <button class="settings-tab-btn" data-tab="domains">
                <i data-lucide="folder-tree" class="tab-icon"></i>
                <span class="tab-label">domains</span>
              </button>
              <button class="settings-tab-btn" data-tab="integrations">
                <i data-lucide="plug" class="tab-icon"></i>
                <span class="tab-label">integrations</span>
              </button>
              <button class="settings-tab-btn" data-tab="advanced">
                <i data-lucide="terminal" class="tab-icon"></i>
                <span class="tab-label">advanced</span>
              </button>
            </div>

            <!-- Tab: General -->
            <div class="settings-tab-content" id="tab-general">
              <div class="settings-section">
                <h3>Paths</h3>

                <div class="form-group">
                  <label>Code Directories</label>
                  <div class="path-list" id="settings-code-paths"></div>
                  <button class="btn btn-secondary" id="btn-settings-add-code">+ Add</button>
                </div>
                
                <p class="form-hint">
                  <i data-lucide="info" style="width: 14px; height: 14px;"></i>
                  To configure your Obsidian vault, go to Settings → Integrations → Obsidian
                </p>
              </div>

              <div class="settings-section">
                <h3>Model Routing</h3>

                <div class="form-group">
                  <label>Default Mode</label>
                  <select id="settings-routing-mode">
                    <option value="auto">Auto (Recommended)</option>
                    <option value="local">Always Local</option>
                    <option value="cloud">Always Cloud</option>
                  </select>
                </div>

                <div class="form-group">
                  <label>Cloud API Key</label>
                  <input type="password" id="settings-api-key" placeholder="sk-...">
                  <p class="form-hint">Anthropic API key for cloud model access</p>
                </div>
              </div>
            </div>

            <!-- Tab: Domains -->
            <div class="settings-tab-content hidden" id="tab-domains">
              <div class="domains-intro">
                <p>Configure your knowledge domains. Domains help organize your Obsidian vault and improve RAG relevance.</p>
              </div>

              <div class="settings-section">
                <h3>Folder Structure</h3>
                <div class="form-group">
                  <label class="checkbox-label">
                    <input type="checkbox" id="folder-numbering-toggle">
                    <span>Use numbered folders (e.g., 01-Sigils, 02-Signals)</span>
                  </label>
                  <p class="form-hint">Numbered folders maintain order in your file system</p>
                </div>
              </div>

              <div class="settings-section">
                <h3>Your Domains</h3>
                <div class="domains-list-header">
                  <span class="domain-count">Loading domains...</span>
                  <button class="btn btn-primary btn-sm" id="btn-add-domain">
                    <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
                    Add Domain
                  </button>
                </div>
                
                <div id="domains-list" class="domains-list">
                  <!-- Domain cards will be rendered here -->
                  <div class="loading-spinner">Loading...</div>
                </div>
              </div>
            </div>

            <!-- Tab: Integrations -->
            <div class="settings-tab-content hidden" id="tab-integrations">
              <div class="integrations-intro">
                <p>Connect external services to enhance Polly's capabilities. Integration data is automatically indexed for RAG queries.</p>
              </div>

              <!-- Integration Cards -->
              <div class="integrations-grid">
                <!-- GitHub Integration Card -->
                <div class="integration-card" data-integration="github">
                  <div class="integration-header">
                    <div class="integration-title">
                      <i data-lucide="github" class="integration-icon"></i>
                      <h4>github</h4>
                    </div>
                    <span class="status-dot" id="github-status-dot"></span>
                  </div>

                  <p class="integration-desc">Access repositories, issues, and pull requests</p>

                  <div class="integration-status" id="github-status">
                    <span class="status-text">not connected</span>
                  </div>

                  <div class="integration-actions">
                    <button class="btn btn-secondary btn-sm" id="github-connect-btn">connect</button>
                    <button class="btn btn-secondary btn-sm hidden" id="github-sync-btn">sync now</button>
                    <button class="btn btn-secondary btn-sm" id="github-config-btn">configure</button>
                  </div>

                  <!-- Expandable Config Panel -->
                  <div class="integration-config hidden" id="github-config">
                    <h5>OAuth Configuration</h5>
                    <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 16px;">
                      Create a GitHub OAuth app at <a href="#" id="github-oauth-link" style="color: var(--signal); text-decoration: underline;">github.com/settings/developers</a>
                    </p>
                    
                    <div class="form-group">
                      <label>Client ID</label>
                      <input type="text" id="github-client-id" placeholder="Iv1.abc123..." />
                    </div>
                    
                    <div class="form-group">
                      <label>Client Secret</label>
                      <input type="password" id="github-client-secret" placeholder="gho_xyz789..." />
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 8px;">
                      <label>Callback URL (use this in OAuth app)</label>
                      <input type="text" value="http://localhost:3000/oauth/callback" readonly style="background: var(--bg-hover); cursor: text;" />
                    </div>
                    
                    <button class="btn btn-primary btn-sm" id="github-save-config-btn">save configuration</button>
                  </div>
                </div>

                <!-- Context7 Integration Card -->
                <div class="integration-card" data-integration="context7">
                  <div class="integration-header">
                    <div class="integration-title">
                      <i data-lucide="book-open" class="integration-icon"></i>
                      <h4>context7</h4>
                    </div>
                    <span class="status-dot" id="context7-status-dot"></span>
                  </div>

                  <p class="integration-desc">Up-to-date library docs for code generation</p>

                  <div class="integration-status" id="context7-status">
                    <span class="status-text">not connected</span>
                  </div>

                  <div class="integration-actions">
                    <button class="btn btn-secondary btn-sm" id="context7-connect-btn">connect</button>
                    <button class="btn btn-secondary btn-sm hidden" id="context7-sync-btn">sync now</button>
                    <button class="btn btn-secondary btn-sm hidden" id="context7-config-btn">configure</button>
                  </div>

                  <div class="integration-config hidden" id="context7-config">
                    <h5>Library Management</h5>
                    <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 16px;">
                      Select popular libraries or add custom ones:
                    </p>
                    
                    <!-- Popular Libraries Checkboxes -->
                    <div style="margin-bottom: 20px;">
                      <h6 style="font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 10px;">Popular Libraries</h6>
