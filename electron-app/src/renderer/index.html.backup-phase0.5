                  id="domain-keywords-input" 
                  placeholder="Type keyword and press Enter..."
                  style="flex: 1; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-secondary); color: var(--text-primary);"
                >
                <button class="btn btn-secondary btn-sm" id="btn-suggest-keywords">
                  <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
              <div class="keywords-tags" id="domain-keywords-tags">
                <!-- Keywords will appear here as chips -->
              </div>
              <div id="suggested-keywords" class="keywords-tags" style="margin-top: 8px; display: none;">
                <!-- Suggested keywords will appear here -->
              </div>
              <p class="form-hint">Keywords used to auto-detect domain for queries</p>
            </div>
          </div>
        </div>

        <div id="domain-editor-error" class="error-message hidden" style="margin-top: 12px; padding: 8px; background: rgba(239, 68, 68, 0.1); border-left: 3px solid #ef4444; color: #ef4444; border-radius: 4px;"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" id="cancel-domain-editor">Cancel</button>
        <button class="btn btn-primary" id="save-domain-editor">Save Domain</button>
      </div>
    </div>
  </div>

  <script src="app.js"></script>
  <script>
    // Debug and initialize Lucide icons
    console.log('Lucide loaded:', typeof lucide !== 'undefined');
    window.addEventListener('load', () => {
      console.log('Window loaded, initializing icons...');
      if (window.lucide) {
        try {
          lucide.createIcons();
          console.log('Icons initialized successfully');
        } catch (error) {
          console.error('Error initializing icons:', error);
        }
      } else {
        console.error('Lucide not found');
      }
    });
  </script>
</body>
</html>
