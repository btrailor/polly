  <!-- Save Conversation Modal -->
  <div id="save-conversation-modal" class="modal hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Save Conversation to Obsidian</h3>
        <button class="modal-close" id="close-save-modal">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="note-title">Note Title</label>
          <input 
            type="text" 
            id="note-title" 
            placeholder="Generated from first message..." 
            style="width: 100%; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-secondary); color: var(--text-primary);"
          >
        </div>

        <div class="form-group">
          <label for="note-folder">Folder</label>
          <div style="display: flex; gap: 8px; align-items: center;">
            <input 
              type="text" 
              id="note-folder" 
              placeholder="30-Ideas" 
              style="flex: 1; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-secondary); color: var(--text-primary);"
            >
            <button class="btn btn-secondary btn-sm" id="btn-suggest-folder">
              <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
            </button>
          </div>
          <div id="folder-suggestion" class="suggestion-box hidden" style="margin-top: 8px; padding: 8px; background: var(--bg-hover); border-radius: 4px; border-left: 3px solid var(--signal);">
            <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">Suggested folder:</div>
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <div>
                <span id="suggested-folder-name" style="font-weight: 600; color: var(--text-primary);"></span>
                <span id="suggested-folder-domain" style="margin-left: 8px; font-size: 11px; color: var(--text-secondary);"></span>
              </div>
              <button class="btn btn-sm" id="btn-use-folder" style="padding: 4px 8px; font-size: 11px;">Use</button>
            </div>
            <div id="folder-reasoning" style="margin-top: 4px; font-size: 11px; color: var(--text-secondary);"></div>
          </div>
        </div>

        <div class="form-group">
          <label>Tags (optional)</label>
          <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
            <input 
              type="text" 
              id="note-tags-input" 
              placeholder="Add tags..." 
              style="flex: 1; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-secondary); color: var(--text-primary);"
            >
            <button class="btn btn-secondary btn-sm" id="btn-suggest-tags">
              <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
            </button>
