          <div id="suggested-tags" class="tags-container" style="display: flex; flex-wrap: wrap; gap: 6px; min-height: 28px;"></div>
          <div id="selected-tags" class="tags-container" style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; min-height: 28px;"></div>
        </div>

        <div id="save-modal-status" class="status-message hidden" style="margin-top: 12px; padding: 8px; border-radius: 4px;"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" id="btn-cancel-save">Cancel</button>
        <button class="btn btn-primary" id="btn-confirm-save">Save Note</button>
      </div>
    </div>
