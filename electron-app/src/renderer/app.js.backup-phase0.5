    document.getElementById('domain-name-input').value = domain.name;
    document.getElementById('domain-description-input').value = domain.description || '';
    document.getElementById('domain-folder-input').value = domain.folderPath;
    document.getElementById('domain-weight-slider').value = Math.round(domain.ragWeight * 100);
