/**
 * Generate weight dots visualization
 */
function generateWeightDots(weight) {
  const totalDots = 5;
  const filledDots = Math.round(weight * totalDots);
  let html = '';
  
  for (let i = 0; i < totalDots; i++) {
    html += `<span class="domain-weight-dot ${i < filledDots ? 'filled' : ''}"></span>`;
  }
  
  return html;
}

