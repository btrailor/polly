/**
 * Show a specific view
 */
function showView(view) {
  currentView = view;

  document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
  document.getElementById(`view-${view}`).classList.remove('hidden');

  document.querySelectorAll('.nav-item').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.view === view);
  });

  // Load view-specific data
  if (view === 'dashboard') {
    loadDashboardData();
  } else if (view === 'knowledge') {
    loadKnowledgeData();
  } else if (view === 'patterns') {
    loadPatterns();
  } else if (view === 'settings') {
    // Load domains config if domains tab is active
    const domainsTab = document.querySelector('.settings-tab-btn[data-tab="domains"]');
    if (domainsTab && domainsTab.classList.contains('active')) {
      loadDomainsConfig();
    }
  }
  
  // Re-initialize Lucide icons after view change
  if (typeof lucide !== 'undefined') {
    setTimeout(() => lucide.createIcons(), 0);
  }
}

