/**
 * Load knowledge data
 */
async function loadKnowledgeData() {
  const vaultPath = await window.polly.getStore('vaultPath');
  document.getElementById('obsidian-path').textContent = vaultPath || 'Not configured';

  const savedCodePaths = await window.polly.getStore('codebasePaths') || [];
  const container = document.getElementById('code-source-paths');

  if (savedCodePaths.length) {
    container.innerHTML = savedCodePaths.map(p => `<div class="source-path">${p}</div>`).join('');
  } else {
    container.innerHTML = '<div class="path-empty">No directories configured</div>';
  }

  // Load stats from server
  try {
    const response = await fetch('http://localhost:11436/polly/stats');
    if (response.ok) {
      const data = await response.json();

      // Update knowledge view stats
      const obsidianCount = data.rag?.obsidian?.count || 0;
      const obsidianFiles = data.rag?.obsidian?.files || 0;
      const codebaseCount = data.rag?.codebase?.count || 0;
      const codebaseFiles = data.rag?.codebase?.files || 0;

      document.getElementById('obsidian-files').textContent = `${obsidianFiles} files`;
      document.getElementById('obsidian-chunks').textContent = `${obsidianCount} chunks`;
      document.getElementById('code-files').textContent = `${codebaseFiles} files`;
      document.getElementById('code-chunks').textContent = `${codebaseCount} chunks`;

      // Also update dashboard stats
      document.getElementById('stat-obsidian').textContent = obsidianCount;
      document.getElementById('stat-codebase').textContent = codebaseCount;
      document.getElementById('stat-patterns').textContent = data.rag?.patterns?.count || 0;
      document.getElementById('stat-entities').textContent = data.graph?.entities || 0;
    }
  } catch (error) {
    console.log('Could not load knowledge stats:', error.message);
  }
}

/**
