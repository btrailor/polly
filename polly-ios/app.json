{
  "expo": {
    "name": "Polly",
    "slug": "polly-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "polly",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Polly needs microphone access for voice messages."
        }
      ],
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polly.ios",
      "infoPlist": {
        "NSAllowsLocalNetworking": true,
        "NSFileProtectionComplete": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Polly needs microphone access for voice messages."
      }
    },
    "extra": {
      "eas": {
        "projectId": "85543a01-c4f8-4081-9492-b833b14a3f83"
      },
      "router": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "clarence_bojangles",
    "newArchEnabled": true
  }
}